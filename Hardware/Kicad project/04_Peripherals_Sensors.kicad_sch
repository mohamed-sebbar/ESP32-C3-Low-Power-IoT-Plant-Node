	(text "// Control Functions (1kHz PWM / 60s Auto-Cutoff)\nvoid pump_on(uint8_t speed_pwm) {\n    analogWrite(PIN_PUMP, speed_pwm);\n    start_timer_60s_limit(); \n}\n\nvoid pump_off(void) {\n    analogWrite(PIN_PUMP, 0);\n    stop_timer();\n}"
		(exclude_from_sim no)
		(at 59.436 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "c339332f-0f5f-4d92-8e35-2ed79b0fe424")
	)
