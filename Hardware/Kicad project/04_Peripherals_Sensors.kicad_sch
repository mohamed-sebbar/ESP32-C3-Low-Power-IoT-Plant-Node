	(text "// Read Function (0-4095: ~164 Dark, ~3931 Bright)\nuint16_t read_ldr(void) {\n    return analogRead(PIN_LDR);\n}"
		(exclude_from_sim no)
		(at 182.626 46.482 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "0bb9e590-3656-4674-858c-9bed53c82d59")
	)
	(text "// Address & Command\n#define SHT4X_ADDR 0x44\n#define SHT4X_CMD  0xFD\n\n// Read Function\nvoid read_sht4x(float *temp, float *humidity) {\n    i2c_write(SHT4X_ADDR, SHT4X_CMD);\n    delay_ms(10);\n    uint8_t rx[6] = i2c_read(SHT4X_ADDR, 6);\n\n    uint16_t t_ticks  = (rx[0] << 8) | rx[1];\n    uint16_t rh_ticks = (rx[3] << 8) | rx[4];\n\n    *temp     = -45 + 175 * ((float)t_ticks / 65535);\n    *humidity = -6 + 125 * ((float)rh_ticks / 65535);\n}"
		(exclude_from_sim no)
		(at 57.912 84.836 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "16ab2799-f8f2-4908-8c98-183eb6df92f7")
	)
